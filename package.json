{
  "name": "codetalk-pure",
  "version": "1.0.0",
  "main": "src/main.ts",
  "type": "module",
  "scripts": {
    "start": "node src/main.ts",
    "start:dev": "node --watch src/main.ts",
    "check": "biome check",
    "check:fix": "biome check --fix",
    "check:ci": "biome ci",
    "typecheck": "tsc",
    "precommit": "pnpm run typecheck && pnpm run check",
    "test:unitary": "vitest --config ./test/config/vitest.unitary.ts",
    "test:integration": "vitest --config ./test/config/vitest.integration.ts",
    "test:e2e:db": "vitest --config ./test/config/vitest.e2e-db.ts",
    "test:memory": "vitest --config ./test/config/vitest.memory.ts"
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1130.0",
    "@hono/node-server": "1.19.17",
    "@hono/swagger-ui": "0.4.1",
    "hono": "4.13.7",
    "hono-openapi": "0.3.1",
    "inversify": "6.2.2",
    "mongodb": "6.14.2",
    "pino": "9.14.0",
    "sqs-consumer": "11.6.0",
    "zod": "3.25.76",
    "zod-openapi": "4.2.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/node": "22.20.2",
    "ky": "2.1.0",
    "pino-pretty": "13.1.3",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
